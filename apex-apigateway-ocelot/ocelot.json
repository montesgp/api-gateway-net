{
  "Aggregates": [
    {
      "UpstreamPathTemplate": "/api/usersAlbums",
      "RouteKeys": [ "users", "albums" ],
      "Aggregator": "UsersAlbumsAggregator"
    }
  ],

  "Routes": [
    {
      "UpstreamPathTemplate": "/api/users",
      "UpstreamHttpMethod": [],
      "DownstreamHostAndPorts": [
        {
          "Host": "jsonplaceholder.typicode.com",
          "Port": 443
        }
      ],
      "DownstreamPathTemplate": "/users",
      "Key": "users",
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer"
      }
    },
    {
      "UpstreamPathTemplate": "/api/albums",
      "UpstreamHttpMethod": [],
      "DownstreamHostAndPorts": [
        {
          "Host": "jsonplaceholder.typicode.com",
          "Port": 443
        }
      ],
      "DownstreamPathTemplate": "/albums",
      "Key": "albums"
    },
    {
      "UpstreamPathTemplate": "/api/authenticate",
      "DownstreamScheme": "http",
      "UpstreamHttpMethod": [],
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 4000
        }
      ],
      "DownstreamPathTemplate": "/users/authenticate",
      "Key": "authenticate"
    },
    {
      "UpstreamPathTemplate": "/api/EmailNotification",
      "DownstreamScheme": "https",
      "UpstreamHttpMethod": [],
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 44337
        }
      ],
      "DownstreamPathTemplate": "/api/EmailNotification",
      "SwaggerKey": "ApiNotifications"
    }
  ],

  "SwaggerEndPoints": [
    {
      "Key": "ApiNotifications",
      "Config": [
        {
          "Name": "API Notifications",
          "Version": "v1",
          "Url": "https://localhost:44337/swagger/v1/swagger.json"
        }
      ]
    }
  ],

  "GlobalConfiguration": {
    "BaseUrl": "https://localhost:44372"
  }
}
